		"colorjs.io": "^0.6.1"
	},
	"devDependencies": {
		"@codecov/rollup-plugin": "^2.0.1",
		"@vitest/coverage-v8": "^4.1.4",
		"oxfmt": "^0.49.0",
		"oxlint": "^1.61.0",
		"publint": "^0.3.18",
		"tsdown": "^0.22.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.4"
	},
	"engines": {
		"node": ">=22",
		"pnpm": ">=10.0.0"
	},
	"packageManager": "pnpm@10.30.3",
	"pnpm": {
